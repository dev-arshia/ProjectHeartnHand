# Copy this file to .env and fill in real values before deploying anywhere
# beyond your own laptop. Locally, the app works fine with none of this
# set — it falls back to demo-safe defaults (see backend/server.js and
# backend/routes/admin.js).

# Port the server listens on.
PORT=3000

# Session cookie signing secret. MUST be changed to a long random string
# for any real deployment — the code falls back to a fixed dev value if
# this isn't set, which is fine locally but not safe to deploy with.
SESSION_SECRET=change-me-to-a-long-random-string

# Default admin account, seeded automatically on first boot if the admins
# table is empty. Change these before a public deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Optional: enables two AI-assisted features (smart free-text intake
# parsing, plain-language match explanations). Get a key at
# https://platform.openai.com/api-keys — no key needed to run the app,
# both features fail gracefully and fall back to manual flows without one.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
